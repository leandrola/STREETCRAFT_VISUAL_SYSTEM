{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "type":"object",
  "required":["version","references"],
  "properties":{
    "version":{"type":"string"},
    "canon_version":{"type":"string"},
    "policy":{"type":"string"},
    "references":{
      "type":"array",
      "items":{
        "type":"object",
        "required":["id","asset","reference_type","authority_proposal","status"],
        "properties":{
          "id":{"type":"string"},
          "asset":{"type":"string"},
          "reference_type":{"type":"string"},
          "authority_proposal":{"enum":["GOLD","SILVER","STUDY"]},
          "status":{"enum":["UNREVIEWED","ACCEPTED","CANONICAL","REJECTED"]},
          "profile":{"type":"string"},
          "domain":{"type":"string"}
        }
      }
    }
  }
}
