{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Streetcraft Evidence Unit",
  "type": "object",
  "required": ["domain","observation","evidence_type","confidence","transfer_eligibility"],
  "properties": {
    "domain":{"type":"string"},
    "subject":{"type":"string"},
    "observation":{"type":"string"},
    "visual_location":{"type":"string"},
    "evidence_type":{"enum":["OBSERVED","DERIVED","INFERRED","UNKNOWN"]},
    "confidence":{"type":"number","minimum":0,"maximum":1},
    "transfer_eligibility":{"type":"array","items":{"enum":["DOCUMENTARY_PHYSICS","FORM_REFERENCE","PERIOD_REFERENCE","REGIONAL_REFERENCE","COMPOSITION_REFERENCE","NOT_TRANSFERABLE"]}},
    "notes":{"type":"string"}
  },
  "additionalProperties": false
}
