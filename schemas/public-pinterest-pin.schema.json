{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Streetcraft Public Pinterest Pin",
  "type": "object",
  "required": ["provider", "provider_item_id", "pin_url", "image_url", "board_url", "discovered_at"],
  "properties": {
    "provider": {"const": "pinterest"},
    "provider_item_id": {"type": "string", "minLength": 1},
    "pin_url": {"type": "string", "format": "uri"},
    "image_url": {"type": "string", "format": "uri"},
    "source_url": {"type": ["string", "null"], "format": "uri"},
    "title": {"type": ["string", "null"]},
    "description": {"type": ["string", "null"]},
    "board_url": {"type": "string", "format": "uri"},
    "position": {"type": ["integer", "null"], "minimum": 0},
    "discovered_at": {"type": "string", "format": "date-time"},
    "provider_updated_at": {"type": ["string", "null"]},
    "content_fingerprint": {"type": ["string", "null"]}
  },
  "additionalProperties": true
}
