{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://streetcraft.local/schemas/visual-scene-graph-vsg0.schema.json",
  "title": "Streetcraft Visual Scene Graph VSG-0",
  "type": "object",
  "required": ["schema_version", "mode", "governs_generation", "scene_id", "source_identity", "nodes", "edges", "reference_observations", "functional_subgraphs", "diagnostics", "provenance"],
  "properties": {
    "schema_version": {"const": "0.1.0"},
    "mode": {"const": "OBSERVER"},
    "governs_generation": {"const": false},
    "scene_id": {"type": "string"},
    "source_identity": {"type": "string"},
    "nodes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "type", "source_kind", "label", "confidence", "epistemic_class", "observed", "locks", "evidence"],
        "properties": {
          "id": {"type": "string"},
          "type": {"enum": ["building", "facade", "storefront", "sign", "window", "door", "cornice", "roof", "parapet", "chimney", "hvac", "skylight", "water_tank", "access_bulkhead", "unknown_region", "unclassified"]},
          "confidence": {"type": "number", "minimum": 0, "maximum": 1},
          "locks": {
            "type": "object",
            "required": ["identity", "semantic", "geometry", "occlusion"],
            "additionalProperties": false,
            "properties": {
              "identity": {"type": "boolean"}, "semantic": {"type": "boolean"},
              "geometry": {"type": "boolean"}, "occlusion": {"type": "boolean"}
            }
          }
        },
        "additionalProperties": true
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "type", "from", "to", "confidence", "protection", "epistemic_class", "evidence"],
        "properties": {
          "type": {"enum": ["ABOVE", "BELOW", "LEFT_OF", "RIGHT_OF", "ATTACHED_TO", "INSIDE", "BEHIND", "IN_FRONT_OF", "OCCLUDES", "CONTAINS", "PART_OF"]},
          "confidence": {"type": "number", "minimum": 0, "maximum": 1}
        },
        "additionalProperties": true
      }
    },
    "reference_observations": {"type": "array"},
    "functional_subgraphs": {"type": "array"},
    "diagnostics": {"type": "object"},
    "provenance": {"type": "object"}
  },
  "additionalProperties": false
}
