{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "need_id",
    "state",
    "target_domains",
    "specific_problem",
    "task_context"
  ],
  "properties": {
    "need_id": {
      "type": "string"
    },
    "state": {
      "enum": [
        "RN_NONE",
        "RN_SUPPORT",
        "RN_REQUIRED",
        "RN_BLOCKED"
      ]
    },
    "target_domains": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "specific_problem": {
      "type": "string"
    },
    "task_context": {
      "type": "string"
    },
    "min_provenance": {
      "type": "string"
    },
    "max_transfer_risk": {
      "enum": [
        "LOW",
        "MEDIUM",
        "HIGH"
      ]
    },
    "max_results": {
      "type": "integer",
      "minimum": 1,
      "maximum": 5
    }
  },
  "additionalProperties": true
}