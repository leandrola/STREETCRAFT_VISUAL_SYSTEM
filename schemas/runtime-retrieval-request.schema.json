{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Streetcraft Archive Runtime Retrieval Request",
  "type": "object",
  "required": ["request_id", "requested_domain", "specific_problem", "source_context", "minimum_confidence", "max_results"],
  "properties": {
    "request_id": {"type": "string"},
    "requested_domain": {"type": "string"},
    "specific_problem": {"type": "string"},
    "source_context": {"type": "string"},
    "period_constraint": {"type": ["object", "null"]},
    "regional_constraint": {"type": ["object", "null"]},
    "minimum_provenance": {"enum": ["P0", "P1", "P2", "P3", "P4"]},
    "minimum_confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "allowed_archive_classes": {"type": "array", "items": {"type": "string"}},
    "required_tags": {"type": "array", "items": {"type": "string"}},
    "forbidden_tags": {"type": "array", "items": {"type": "string"}},
    "forbidden_transfer": {"type": "array", "items": {"type": "string"}},
    "source_visual_fingerprint": {"type": ["string", "null"]},
    "max_results": {"type": "integer", "minimum": 0, "maximum": 5}
  },
  "additionalProperties": false
}
