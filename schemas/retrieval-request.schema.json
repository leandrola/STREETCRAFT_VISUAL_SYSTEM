{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Streetcraft Archive Retrieval Request",
  "type": "object",
  "required": ["requested_domain","specific_problem","max_results"],
  "properties": {
    "requested_domain":{"type":"string"},
    "specific_problem":{"type":"string"},
    "period_constraint":{"type":["string","null"]},
    "regional_constraint":{"type":["string","null"]},
    "minimum_provenance":{"enum":["P0","P1","P2","P3","P4"]},
    "minimum_confidence":{"type":"number","minimum":0,"maximum":1},
    "forbidden_transfer":{"type":"array","items":{"type":"string"}},
    "max_results":{"type":"integer","minimum":1,"maximum":10}
  },
  "additionalProperties": true
}
