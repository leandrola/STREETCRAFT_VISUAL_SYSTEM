{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Streetcraft Archive Classifier Output",
  "type": "object",
  "required": ["archive_class", "image_status", "scene_summary", "evidence_units", "temporal_estimate", "regional_estimate", "retrieval", "validation"],
  "properties": {
    "archive_class": {"const": "DOCUMENTARY_EVIDENCE"},
    "image_status": {"enum": ["USABLE", "LIMITED", "UNUSABLE"]},
    "scene_summary": {"type": "string", "maxLength": 600},
    "evidence_units": {
      "type": "array",
      "items": {"$ref": "evidence-unit.schema.json"}
    },
    "temporal_estimate": {
      "type": "object",
      "required": ["value", "confidence", "basis"],
      "properties": {
        "value": {"type": ["string", "null"]},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "basis": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": false
    },
    "regional_estimate": {
      "type": "object",
      "required": ["value", "confidence", "basis"],
      "properties": {
        "value": {"type": ["string", "null"]},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "basis": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": false
    },
    "provenance": {
      "type": "object",
      "properties": {
        "level": {"enum": ["P0", "P1", "P2", "P3", "P4"]},
        "source_url": {"type": ["string", "null"]},
        "original_source_url": {"type": ["string", "null"]},
        "notes": {"type": "string"}
      },
      "additionalProperties": false
    },
    "retrieval": {
      "type": "object",
      "required": ["descriptors", "high_risk_terms"],
      "properties": {
        "descriptors": {"type": "array", "items": {"type": "string"}, "maxItems": 40},
        "high_risk_terms": {"type": "array", "items": {"type": "string"}, "maxItems": 40}
      },
      "additionalProperties": false
    },
    "validation": {
      "type": "object",
      "required": ["status", "flags"],
      "properties": {
        "status": {"enum": ["PASS", "QUARANTINE", "REJECT"]},
        "flags": {"type": "array", "items": {"type": "string"}},
        "diagnostics": {"type": "string"}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
