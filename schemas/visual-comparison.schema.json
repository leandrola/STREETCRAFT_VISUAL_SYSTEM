{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["overall_status", "domains", "critic_confidence"],
  "properties": {
    "overall_status": {"type": "string"},
    "domains": {"type": "object"},
    "anchor_deltas": {"type": "array"},
    "relationship_deltas": {"type": "array"},
    "preservation_deltas": {"type": "array"},
    "reconstruction_findings": {"type": "array"},
    "unauthorized_changes": {"type": "array"},
    "uncertainty_findings": {"type": "array"},
    "hard_failure_candidates": {"type": "array"},
    "critic_confidence": {"enum": ["HIGH","MEDIUM","LOW","UNKNOWN"]}
  },
  "additionalProperties": true
}
