{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "runtime_status",
    "needs",
    "admissions",
    "unresolved_needs"
  ],
  "properties": {
    "runtime_status": {
      "enum": [
        "NOT_NEEDED",
        "READY",
        "PARTIAL",
        "REFERENCE_UNRESOLVED",
        "ARCHIVE_UNAVAILABLE",
        "BLOCKED",
        "REVIEW"
      ]
    },
    "needs": {
      "type": "array"
    },
    "admissions": {
      "type": "array"
    },
    "unresolved_needs": {
      "type": "array"
    }
  },
  "additionalProperties": true
}