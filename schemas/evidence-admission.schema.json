{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "evidence_unit_id",
    "decision",
    "domain",
    "reasons"
  ],
  "properties": {
    "evidence_unit_id": {
      "type": "string"
    },
    "decision": {
      "enum": [
        "ADMITTED_SCOPED",
        "ADMITTED_NEGATIVE_ONLY",
        "REVIEW_REQUIRED",
        "REJECTED"
      ]
    },
    "domain": {
      "type": "string"
    },
    "reasons": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": true
}