{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["id", "domain", "failure_class", "severity", "confidence", "correction_scope", "collateral_risk"],
  "properties": {
    "id": {"type": "string"},
    "domain": {"type": "string"},
    "location": {"type": ["string","object"]},
    "observed_delta": {},
    "expected_state": {},
    "failure_class": {"type": "string"},
    "severity": {"enum": ["S0","S1","S2","S3","S4"]},
    "confidence": {"enum": ["HIGH","MEDIUM","LOW","UNKNOWN"]},
    "preservation_level": {"type": "string"},
    "affected_anchor": {},
    "affected_relationship": {},
    "probable_cause": {"type": "string"},
    "propagation": {"type": "string"},
    "correction_scope": {"enum": ["LOCAL","REGIONAL","DOMAIN-WIDE","SYSTEMIC"]},
    "collateral_risk": {"enum": ["CR0","CR1","CR2","CR3","CR4"]}
  },
  "additionalProperties": true
}
