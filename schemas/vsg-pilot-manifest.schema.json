{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "fixture_id": {
      "type": "string",
      "minLength": 1
    },
    "pilot_enabled": {
      "type": "boolean"
    },
    "source_binding": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "source_identity": {
          "type": "string",
          "minLength": 1
        },
        "attested_by": {
          "type": "string",
          "minLength": 1
        },
        "evidence": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "source_identity",
        "attested_by",
        "evidence"
      ]
    },
    "artifacts": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "request": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1
            },
            "sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "provenance": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "path",
            "sha256",
            "provenance"
          ]
        },
        "runtime": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1
            },
            "sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "provenance": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "path",
            "sha256",
            "provenance"
          ]
        },
        "sar2": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1
            },
            "sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "provenance": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "path",
            "sha256",
            "provenance"
          ]
        },
        "rr2": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1
            },
            "sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "provenance": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "path",
            "sha256",
            "provenance"
          ]
        },
        "cgc_final": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1
            },
            "sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "provenance": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "path",
            "sha256",
            "provenance"
          ]
        },
        "expected_graph": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1
            },
            "sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "provenance": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "path",
            "sha256",
            "provenance"
          ]
        },
        "candidate_graph": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1
            },
            "sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "provenance": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "path",
            "sha256",
            "provenance"
          ]
        },
        "generation_context": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1
            },
            "sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "provenance": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "path",
            "sha256",
            "provenance"
          ]
        },
        "contract": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1
            },
            "sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "provenance": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "path",
            "sha256",
            "provenance"
          ]
        },
        "source": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1
            },
            "sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "provenance": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "path",
            "sha256",
            "provenance"
          ]
        }
      },
      "required": [
        "request",
        "runtime",
        "sar2",
        "rr2",
        "cgc_final",
        "expected_graph",
        "candidate_graph",
        "generation_context",
        "contract",
        "source"
      ]
    },
    "required_priorities": {
      "type": "array",
      "items": {
        "enum": [
          "P0",
          "PR0",
          "PR1",
          "LOCK"
        ]
      },
      "uniqueItems": true,
      "minItems": 1
    },
    "generation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "provider": {
          "type": "string",
          "minLength": 1
        },
        "model": {
          "type": "string",
          "minLength": 1
        },
        "seed": {
          "type": [
            "integer",
            "null"
          ]
        },
        "parameters": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "size": {
              "type": "string",
              "minLength": 1
            },
            "quality": {
              "type": "string",
              "minLength": 1
            },
            "output_format": {
              "enum": [
                "png",
                "jpeg",
                "webp"
              ]
            }
          },
          "required": [
            "size",
            "quality",
            "output_format"
          ]
        }
      },
      "required": [
        "provider",
        "model",
        "seed",
        "parameters"
      ]
    },
    "rubric": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "constraint_id": {
            "type": "string",
            "minLength": 1
          },
          "category": {
            "enum": [
              "relation",
              "identity",
              "lock",
              "unauthorized_change"
            ]
          },
          "priority": {
            "type": "string",
            "minLength": 1
          },
          "target": {
            "type": "string",
            "minLength": 1
          },
          "criterion": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "constraint_id",
          "category",
          "priority",
          "target",
          "criterion"
        ]
      },
      "minItems": 1
    }
  },
  "required": [
    "schema_version",
    "fixture_id",
    "pilot_enabled",
    "source_binding",
    "artifacts",
    "required_priorities",
    "generation",
    "rubric"
  ],
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
