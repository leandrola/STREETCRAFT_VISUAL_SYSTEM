    "kind",
    "roles",
    "preservation_level",
    "epistemic_class"
  ],
  "properties": {
    "entity_id": {
      "type": "string"
    },
    "kind": {
      "type": "string"
    },
    "roles": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "preservation_level": {
      "type": "string"
    },
    "epistemic_class": {
      "type": "string"
    }
  },
  "additionalProperties": true
}