{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "fixture_id": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "PASS",
        "FAIL",
        "INCONCLUSIVE",
        "BLOCKED"
      ]
    },
    "reason": {
      "type": "string",
      "minLength": 1
    },
    "delta_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "images": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "technical_failures": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "visual_verdict": {
      "enum": [
        "BETTER",
        "TIE",
        "WORSE",
        "INDETERMINATE"
      ]
    },
    "seed_controlled": {
      "type": "boolean"
    }
  },
  "required": [
    "schema_version",
    "run_id",
    "fixture_id",
    "status",
    "reason",
    "delta_sha256",
    "images",
    "technical_failures",
    "visual_verdict",
    "seed_controlled"
  ],
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
