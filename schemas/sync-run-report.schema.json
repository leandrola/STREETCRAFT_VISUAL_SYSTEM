{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Streetcraft Archive Sync Run Report",
  "type": "object",
  "required": ["run_id", "provider", "board_url", "started_at", "status", "counts"],
  "properties": {
    "run_id": {"type": "string"},
    "provider": {"type": "string"},
    "board_url": {"type": "string"},
    "started_at": {"type": "string"},
    "finished_at": {"type": ["string", "null"]},
    "status": {"enum": ["RUNNING", "SUCCESS", "PARTIAL", "FAILED"]},
    "enumeration_mode": {"enum": ["FULL", "PARTIAL", "DELTA"]},
    "counts": {
      "type": "object",
      "required": ["seen", "new", "changed", "unchanged", "missing", "failed"],
      "properties": {
        "seen": {"type": "integer", "minimum": 0},
        "new": {"type": "integer", "minimum": 0},
        "changed": {"type": "integer", "minimum": 0},
        "unchanged": {"type": "integer", "minimum": 0},
        "missing": {"type": "integer", "minimum": 0},
        "failed": {"type": "integer", "minimum": 0}
      }
    },
    "errors": {"type": "array", "items": {"type": "object"}}
  },
  "additionalProperties": true
}
