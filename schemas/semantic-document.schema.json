{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Streetcraft Archive Semantic Document",
  "type": "object",
  "required": ["semantic_document_id", "archive_id", "evidence_unit_id", "document_text", "index_version"],
  "properties": {
    "semantic_document_id": {"type": "string"},
    "archive_id": {"type": "string"},
    "evidence_unit_id": {"type": "string"},
    "document_text": {"type": "string"},
    "index_version": {"type": "string"},
    "embedding": {
      "type": ["object", "null"],
      "properties": {
        "provider": {"type": "string"},
        "model": {"type": "string"},
        "dimensions": {"type": ["integer", "null"]},
        "external_key": {"type": "string"}
      },
      "required": ["provider", "model", "external_key"],
      "additionalProperties": false
    }
  },
  "additionalProperties": true
}
