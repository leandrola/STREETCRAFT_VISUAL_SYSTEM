{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Streetcraft Archive Item",
  "type": "object",
  "required": ["archive_id", "class", "source", "source_status", "evidence_units"],
  "properties": {
    "archive_id": {"type":"string","pattern":"^SCA-[0-9]{6}$"},
    "class": {"enum":["DOCUMENTARY_EVIDENCE","INFLUENCE_REFERENCE","CANON_CANDIDATE","CANONICAL","REJECTED"]},
    "source_status": {"enum":["AVAILABLE","UNAVAILABLE","UNKNOWN"]},
    "source": {
      "type":"object",
      "required":["provider","external_id","item_url"],
      "properties": {
        "provider":{"type":"string"},
        "external_id":{"type":"string"},
        "item_url":{"type":"string"},
        "board_url":{"type":"string"},
        "outbound_source_url":{"type":["string","null"]}
      },
      "additionalProperties": true
    },
    "provenance_level": {"enum":["P0","P1","P2","P3","P4"]},
    "period": {"type":"object"},
    "region": {"type":"object"},
    "evidence_units": {"type":"array","items":{"$ref":"evidence-unit.schema.json"}},
    "visual_fingerprint":{"type":"string"},
    "first_ingested_at":{"type":"string"},
    "last_synced_at":{"type":"string"}
  },
  "additionalProperties": true
}
