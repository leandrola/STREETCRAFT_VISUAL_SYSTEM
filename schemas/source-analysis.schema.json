{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://streetcraft.local/schemas/source-analysis.schema.json",
  "title": "Streetcraft Source Analysis Record",
  "type": "object",
  "required": ["source_domain", "scene", "preservation", "uncertainty", "readiness"],
  "properties": {
    "source_domain": {"type": "string"},
    "scene": {"type": "object"},
    "camera": {"type": "object"},
    "architecture": {"type": "object"},
    "materials": {"type": "object"},
    "signage": {"type": "object"},
    "light": {"type": "object"},
    "objects": {"type": "array"},
    "veg": {"type": "array"},
    "preservation": {"type": "object"},
    "uncertainty": {"type": "object"},
    "scene_understanding": {"type": "object"},
    "risk": {"type": "object"},
    "readiness": {"enum": ["READY","READY_WITH_INFERENCE","REFERENCE_ADVISED","INSUFFICIENT_EVIDENCE","MODE_CONFLICT","USER_DECISION_REQUIRED"]}
  },
  "additionalProperties": true
}
