{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Streetcraft Archive Normalized Connector Snapshot",
  "type": "object",
  "required": ["provider", "board_url", "enumerated_at", "enumeration_mode", "items"],
  "properties": {
    "provider": {"type": "string", "minLength": 1},
    "board_url": {"type": "string", "minLength": 1},
    "board_external_id": {"type": ["string", "null"]},
    "enumerated_at": {"type": "string"},
    "enumeration_mode": {"enum": ["FULL", "PARTIAL", "DELTA"]},
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["pin_url"],
        "properties": {
          "external_id": {"type": ["string", "null"]},
          "pin_url": {"type": "string", "minLength": 1},
          "image_url": {"type": ["string", "null"]},
          "image_reference": {"type": ["string", "null"]},
          "caption": {"type": ["string", "null"]},
          "outbound_source_url": {"type": ["string", "null"]},
          "provider_updated_at": {"type": ["string", "null"]}
        },
        "anyOf": [
          {"required": ["external_id"]},
          {"required": ["pin_url"]}
        ],
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
